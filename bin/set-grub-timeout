#!/usr/bin/env bash
# Меняет время показа меню GRUB (по умолчанию 1 секунда) и пересобирает grub.cfg.
#   sudo ~/macos-kde/bin/set-grub-timeout      # 1 секунда
#   sudo ~/macos-kde/bin/set-grub-timeout 2    # 2 секунды
set -euo pipefail
T="${1:-1}"
[[ "$T" =~ ^[0-9]+$ ]] || { echo "Укажите число секунд"; exit 1; }
[[ $EUID -eq 0 ]] || { echo "Запустите через sudo"; exit 1; }
CFG=/boot/grub/grub.cfg
[[ -f $CFG ]] || { echo "Не найден $CFG — проверьте, что загрузчик GRUB"; exit 1; }

cp -a /etc/default/grub "/etc/default/grub.bak-$(date +%Y%m%d-%H%M%S)"
sed -i "s/^GRUB_TIMEOUT=.*/GRUB_TIMEOUT=$T/" /etc/default/grub
grep -q '^GRUB_TIMEOUT=' /etc/default/grub || echo "GRUB_TIMEOUT=$T" >> /etc/default/grub
grub-mkconfig -o "$CFG"
echo "Готово: меню GRUB показывается $T с. Копия старого файла — /etc/default/grub.bak-*"
